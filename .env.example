# 本機開發用範本。正式（GitHub Actions）環境不使用 .env，
# 帳密與裝置名稱一律放 GitHub Secrets（見 README「快速開始」）。
# 絕對不要把填好真實帳密的 .env commit 進版控（.gitignore 已排除）。
INNOKNIGHT_USERNAME=your-email-or-phone
INNOKNIGHT_PASSWORD=your-password
# 充電樁名稱（在 InnoKnight 網站上顯示的完整名稱），必填、無預設值。
INNOKNIGHT_DEVICE_NAME=your-charger-name
# Optional if the site requires reCAPTCHA login token (dev/testing only).
INNOKNIGHT_RECAPTCHA_TOKEN=
INNOKNIGHT_START_TIME=00:30
INNOKNIGHT_END_TIME=06:00
# 預約目標日 = 今天 + N 天。雲端版前一晚觸發，預設 1（明天）。
INNOKNIGHT_TARGET_OFFSET_DAYS=1
INNOKNIGHT_CDP_PORT=9224
INNOKNIGHT_CHROME_PATH=/usr/bin/google-chrome
INNOKNIGHT_CHROME_PROFILE=/tmp/chrome-innoknight-cron
INNOKNIGHT_LOGIN_TIMEOUT=90
